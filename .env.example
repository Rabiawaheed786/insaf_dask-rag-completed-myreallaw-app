# Is file ko copy karke ".env" name se save karein. ".env" ko kabhi share ya git mein na daalein.
APP_ENV=development
DATABASE_URL=sqlite:///./insaf_dastak.db
# Production mein HTTPS ke saath true rakhein; local http par false.
COOKIE_SECURE=false
SESSION_DAYS=7
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Itne din baad request overdue maani jati hai aur user ko alternatives dikhte hain.
OVERDUE_DAYS=7
# --- Phase 6: private files aur chat ---
# Files is folder mein random name se rakhi jati hain; yeh folder web par kabhi serve nahi hota.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_FILES_PER_CASE=10
CHAT_HOURLY_LIMIT=60

# --- Admin-managed AI keys ---
# Admin panel se save hone wali API keys isi secret se encrypt hoti hain.
# Production mein kam az kam 32 harf ka random secret set karein; ise badalne se purani keys decrypt nahi hongi.
AI_KEY_SECRET=

# --- Phase 9: RAG (verified qanooni PDFs par sawal-jawab) ---
# local = offline, bina key ke (lafzon ki milawat); gemini = matlab ki milawat (key aur AI_ENABLED=true chahiye).
RAG_EMBEDDER=local
EMBED_MODEL=gemini-embedding-001
RAG_TOP_K=4
# -1 = khud tay (local 0.18, gemini 0.55)
RAG_MIN_SCORE=-1
RAG_USE_LLM=true
# OCR ke liye Tesseract (alag install): Windows par jaise C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANG=eng

# --- Phase 8: hifazat, retention ---
# Band hui requests ka text, chat aur files itne din baad khud mita diye jate hain (tracking number baqi rehta hai).
RETENTION_DAYS=365
# Har IP par hadd (ghalat andaza lagane wali koshishon se bachao).
LOGIN_PER_MINUTE_IP=20
SIGNUP_PER_HOUR_IP=20
# Proxy ke peeche chalayein to apna domain yahan likhein, jaise https://insafdastak.pk (comma se alag).
TRUSTED_ORIGINS=

# --- Phase 7: reminders aur availability ---
# Scheduler har itne second baad reminders aur offer ki meead dekhta hai. Restart ke baad duplicate nahi banta.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
SLOT_MIN_MINUTES=15
SLOT_MAX_MINUTES=240
SLOT_MAX_DAYS_AHEAD=60

# --- Phase 4: AI. Default band hai; manual submission AI ke bagair bhi chalti hai. ---
# Asal keys admin panel ("AI Configuration" card) se DB mein encrypt ho kar save hoti hain.
# Neeche wala AI_API_KEY sirf fallback hai jab DB mein koi provider set na ho.
AI_ENABLED=false
# Key sirf yahan likhein. Chat, git ya screenshot mein kabhi share na karein.
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
# free ya paid. Free key par Google content ko apne products behtar karne ke liye istemal karta hai
# aur insani reviewer parh sakte hain. Is liye free tier par asli users ka data nahi bheja jata:
# app sirf APP_ENV=development mein chalegi. Asli istemal ke liye billing wali (paid) key aur AI_TIER=paid.
AI_TIER=free
AI_TIMEOUT_SECONDS=60
AI_HOURLY_LIMIT=10
